# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored by Next.js by default — never commit real keys.

# Powers the Employee Dashboard's AI sales assistant (pages/api/chat.js), via OpenRouter.
# Get a key from https://openrouter.ai/settings/keys
# If this is left empty, the assistant automatically falls back to a rule-based
# reply so the app never breaks during a demo.
OPENROUTER_API_KEY=
