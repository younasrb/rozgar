# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored by Next.js by default — never commit real keys.

# Supabase (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# xAI Grok — powers the Employee Dashboard's AI sales assistant (pages/api/ai-assistant.js)
# Get a key from https://console.x.ai
# If this is left empty, the assistant automatically falls back to a rule-based
# reply so the app never breaks during a demo.
XAI_API_KEY=
GROK_MODEL=grok-4.3

# ElevenLabs — powers the AI's spoken voice replies (pages/api/tts.js)
# Get a key from https://elevenlabs.io (Profile > API Keys)
# Pick any voice ID from your ElevenLabs Voice Library (default below is the
# built-in "Rachel" voice). If left empty, voice replies automatically fall
# back to the browser's built-in text-to-speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
