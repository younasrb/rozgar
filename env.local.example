# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored (see .gitignore) — never commit real keys.
# The app is designed to keep working (with safe fallbacks) even if every value
# below is left blank, so it never breaks a live demo.

# --- Supabase (database + auth) ---
# Supabase Dashboard > Project Settings > API. If left blank, the app falls back
# to the shared hackathon demo project hardcoded in lib/supabaseClient.js — set
# your own here once you have a real project so you're not sharing one database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI sales assistant (pages/api/ai-assistant.js), via xAI's Grok API ---
# Get a key from https://console.x.ai
# If left empty, the assistant automatically falls back to a rule-based reply,
# so the app never breaks during a demo.
XAI_API_KEY=
GROK_MODEL=grok-4-fast
